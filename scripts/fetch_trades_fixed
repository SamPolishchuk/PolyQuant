import os
import time
from datetime import timedelta

import pandas as pd
import requests
from py_clob_client.client import ClobClient
from py_clob_client.clob_types import TradeParams

"""
private 0xb85d5c7296bbdd166848ddeb01ef197397da28d8c73fd2999d45e5e14cff6684
funder 0xfe65407b4e3f249d376d958e6adb916149143cc0
CLOB EMAIL/MAGIC SCRAPER

ENV VARS YOU MUST SET:
  PRIVATE_KEY      = exported from https://reveal.magic.link/polymarket (DO NOT SHARE IT)
  FUNDER_ADDRESS   = your Polymarket proxy wallet address (where you deposit funds)
Optional:
  CLOB_HOST        = https://clob.polymarket.com (default)
  POLY_CHAIN_ID    = 137 (Polygon) (default)

Windows PowerShell (session-only):
  $env:PRIVATE_KEY="0x..."
  $env:FUNDER_ADDRESS="0x..."
  python clob_scrape.py
"""

# -----------------
# CONFIG
# -----------------
MARKET_FILE = "data/market_ids_insider_only.csv"
CHECKPOINT_FILE = "data/trade_checkpoints.csv"

# Output
WINDOW_HOURS = 48
TRADES_CSV = f"data/clob_trades_last_{WINDOW_HOURS}h.csv"
DONE_COL = f"done_clob_{WINDOW_HOURS}h"

# Filtering / thresholds
MIN_LIFETIME_TRADES = 10          # on first page (rough sanity check)
MIN_TRADES_IN_WINDOW = 5          # minimum trades within WINDOW_HOURS to keep market
SLEEP_SECONDS = 0.35
TIMEOUT = 30

# Optional: enrich maker_address with “value/traded” from data-api (wallet stats)
ENRICH_USER_STATS = True
USER_VALUE_URL = "https://data-api.polymarket.com/value"
USER_TRADED_URL = "https://data-api.polymarket.com/traded"
USER_CACHE = {}

# -----------------
# AUTH / CLIENT
# -----------------
HOST = os.getenv("CLOB_HOST", "https://clob.polymarket.com")
CHAIN_ID = int(os.getenv("POLY_CHAIN_ID", "137"))

PRIVATE_KEY = os.getenv("PRIVATE_KEY")
FUNDER_ADDRESS = os.getenv("FUNDER_ADDRESS")

if not PRIVATE_KEY:
    raise ValueError("Missing env var PRIVATE_KEY (export from https://reveal.magic.link/polymarket).")
if not FUNDER_ADDRESS:
    raise ValueError("Missing env var FUNDER_ADDRESS (your Polymarket proxy/funder address).")

# Email/Magic account => signature_type=1
SIGNATURE_TYPE = 1

# -----------------
# HELPERS
# -----------------
def append_to_csv(df: pd.DataFrame, path: str):
    if df.empty:
        return
    write_header = not os.path.exists(path)
    df.to_csv(path, mode="a", index=False, header=write_header)

def log_csv_status(csv_path: str):
    if not os.path.exists(csv_path):
        print("    📄 CSV does not exist yet.")
        return
    try:
        df_tail = pd.read_csv(csv_path, usecols=["match_time"])
        total_rows = len(df_tail)
        last_ts = pd.to_datetime(df_tail["match_time"].iloc[-1], utc=True, errors="coerce")
        print(f"    📊 CSV rows: {total_rows:,}")
        print(f"    🕒 Last appended trade: {last_ts}")
    except Exception as e:
        print(f"    ⚠ Could not read CSV status: {e}")

def get_user_stats(wallet: str):
    if wallet in USER_CACHE:
        return USER_CACHE[wallet]

    stats = {"user_total_value": 0, "user_total_trades": 0}
    try:
        r_val = requests.get(USER_VALUE_URL, params={"user": wallet}, timeout=TIMEOUT)
        val_data = r_val.json()
        if val_data and isinstance(val_data, list):
            stats["user_total_value"] = val_data[0].get("value", 0)

        r_trd = requests.get(USER_TRADED_URL, params={"user": wallet}, timeout=TIMEOUT)
        trd_data = r_trd.json()
        stats["user_total_trades"] = trd_data.get("traded", 0)
    except Exception:
        pass

    USER_CACHE[wallet] = stats
    return stats

def normalize_trades(trades: list) -> pd.DataFrame:
    df = pd.DataFrame(trades)
    if df.empty:
        return df

    # CLOB returns match_time as string; coerce to UTC datetime
    if "match_time" in df.columns:
        df["match_time"] = pd.to_datetime(df["match_time"], utc=True, errors="coerce")

    # Useful numeric coercions
    for col in ["price", "size", "fee_rate_bps", "bucket_index"]:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")

    return df

def fetch_trades_timewalk(client: ClobClient, condition_id: str, cutoff_time: pd.Timestamp) -> pd.DataFrame:
    """
    Time-walk backwards using `before` to avoid offset ceilings.
    Stops when oldest trade in page <= cutoff_time.
    """
    out = []
    before_ts = None  # unix seconds; None = latest

    while True:
        time.sleep(SLEEP_SECONDS)

        params = TradeParams(
            market=condition_id,
            before=str(before_ts) if before_ts is not None else None
        )

        trades = client.get_trades(params)
        if not trades:
            break

        df = normalize_trades(trades)
        if df.empty or "match_time" not in df.columns:
            break

        # sanity check on first page
        if before_ts is None and len(df) < MIN_LIFETIME_TRADES:
            # not “dead”, but likely illiquid
            return df  # return what we have, caller decides what to do

        keep = df[df["match_time"] >= cutoff_time].copy()
        if not keep.empty:
            out.append(keep)

        oldest = df["match_time"].min()
        if pd.isna(oldest):
            break

        if oldest <= cutoff_time:
            break

        before_ts = int(oldest.timestamp()) - 1  # step back 1s to avoid repeats

    if not out:
        return pd.DataFrame()
    return pd.concat(out, ignore_index=True)

# -----------------
# MAIN
# -----------------
if __name__ == "__main__":
    # Init client (L1)
    client = ClobClient(
        HOST,
        key=PRIVATE_KEY,
        chain_id=CHAIN_ID,
        signature_type=SIGNATURE_TYPE,
        funder=FUNDER_ADDRESS,
    )

    # Derive and set API creds (L2) for /data/* endpoints
    client.set_api_creds(client.create_or_derive_api_creds())

    # Load checkpoints
    if os.path.exists(CHECKPOINT_FILE):
        checkpoints = pd.read_csv(CHECKPOINT_FILE)
    else:
        checkpoints = pd.DataFrame(columns=["conditionId", "is_structurally_dead", DONE_COL])

    for col in ["is_structurally_dead", DONE_COL]:
        if col not in checkpoints.columns:
            checkpoints[col] = False

    dead_ids = set(checkpoints.loc[checkpoints["is_structurally_dead"], "conditionId"])
    done_ids = set(checkpoints.loc[checkpoints[DONE_COL], "conditionId"])

    # Load markets
    markets_df = pd.read_csv(MARKET_FILE).copy()
    markets_df = markets_df[~markets_df["conditionId"].isin(dead_ids | done_ids)].copy()

    # Fix dates: parse both closedTime and endDate as UTC
    markets_df["closedTime"] = pd.to_datetime(markets_df.get("closedTime"), utc=True, errors="coerce")
    markets_df["endDate"] = pd.to_datetime(markets_df.get("endDate"), utc=True, errors="coerce")
    markets_df = markets_df.dropna(subset=["closedTime", "endDate"])

    print(f"✅ Target File: {TRADES_CSV}")
    print(f"✅ Tracking via column: {DONE_COL}")
    print(f"✅ Ready to process {len(markets_df)} markets.")
    print(f"✅ Using EMAIL/Magic mode: signature_type={SIGNATURE_TYPE}, funder={FUNDER_ADDRESS}")

    total_appended = 0
    iteration_counter = 0

    for _, market in markets_df.iterrows():
        question = market.get("question", "")
        close_time = market["closedTime"]
        end_time = market["endDate"]
        condition_id = market["conditionId"]

        # ensure close_time not after end_time
        if close_time > end_time:
            close_time = end_time

        cutoff_time = close_time - timedelta(hours=WINDOW_HOURS)

        print(f"\n▶ Market: {question}")
        print(f"   conditionId={condition_id}")
        print(f"   close_time={close_time} cutoff_time={cutoff_time}")

        done_this_window = False
        structurally_dead = False

        try:
            df_window = fetch_trades_timewalk(client, condition_id, cutoff_time)

            if df_window.empty:
                print(f"  No trades returned in the last {WINDOW_HOURS}h.")
                done_this_window = True
            else:
                # if fetch_trades_timewalk returned only first page due to low lifetime trades,
                # df_window might include older trades too; re-filter strictly:
                if "match_time" in df_window.columns:
                    df_window = df_window[df_window["match_time"] >= cutoff_time].copy()

                if df_window.empty:
                    print(f"  Trades exist but none inside the last {WINDOW_HOURS}h.")
                    done_this_window = True
                elif len(df_window) < MIN_TRADES_IN_WINDOW:
                    print(f"  ! Only {len(df_window)} trades in-window (<{MIN_TRADES_IN_WINDOW}). Marking structurally dead.")
                    structurally_dead = True
                    done_this_window = True
                else:
                    # Optional enrichment
                    if ENRICH_USER_STATS and "maker_address" in df_window.columns:
                        makers = df_window["maker_address"].dropna().unique()
                        user_map = {m: get_user_stats(m) for m in makers}
                        df_window["user_total_value"] = df_window["maker_address"].map(
                            lambda x: user_map.get(x, {}).get("user_total_value", 0)
                        )
                        df_window["user_total_trades"] = df_window["maker_address"].map(
                            lambda x: user_map.get(x, {}).get("user_total_trades", 0)
                        )

                    df_window["conditionId"] = condition_id
                    append_to_csv(df_window, TRADES_CSV)
                    total_appended += len(df_window)

                    print(f"    ✅ Added {len(df_window)} trades (CLOB time-walk).")
                    done_this_window = True

            iteration_counter += 1
            if iteration_counter % 25 == 0:
                print("\n🔎 Progress checkpoint")
                log_csv_status(TRADES_CSV)

        except Exception as e:
            print(f"  Error: {e}")
            time.sleep(2)

        # Update checkpoints
        row = {
            "conditionId": condition_id,
            "is_structurally_dead": structurally_dead,
            DONE_COL: bool(done_this_window),
        }

        checkpoints = checkpoints[checkpoints["conditionId"] != condition_id]
        checkpoints = pd.concat([checkpoints, pd.DataFrame([row])], ignore_index=True)
        checkpoints.to_csv(CHECKPOINT_FILE, index=False)

    print(f"\n✅ Scraping finished. Total rows added: {total_appended}")
